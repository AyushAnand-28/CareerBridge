# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (replica set required for Prisma transactions).
# Get yours at: https://cloud.mongodb.com → Clusters → Connect → Drivers
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/careerbridge?retryWrites=true&w=majority"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace_with_a_long_random_secret_string"
JWT_EXPIRES_IN="7d"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── CORS ─────────────────────────────────────────────────────────────────────
# The URL of your deployed frontend (Vercel URL or custom domain)
FRONTEND_URL="https://your-frontend.vercel.app"

# ─── Cloudinary (File Uploads) ────────────────────────────────────────────────
# Get these at: https://cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# ─── AI (Groq) ────────────────────────────────────────────────────────────────
# Required for AI-powered resume matching. Get a free key at: https://console.groq.com/keys
# If left blank, the app automatically falls back to keyword-based matching.
GROQ_API_KEY="your_groq_api_key"
