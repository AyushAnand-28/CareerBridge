# ─── Database ───────────────────────────────────────────────────────────────
# MongoDB connection string (must be a replica set for Prisma transactions)
DATABASE_URL="mongodb://127.0.0.1:27017/careerbridge?replicaSet=rs0&directConnection=true"

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="c44de1d6b2cc00c6d9a63932888aff6b782555be4f06b713912e960237e1416f53f7e8daeaa3f1e07d3f9a751e857294cb"
JWT_EXPIRES_IN="7d"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGIN="http://localhost:5173"

